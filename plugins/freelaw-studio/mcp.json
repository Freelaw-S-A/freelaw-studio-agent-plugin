{
  "$schema": "https://agent-plugins.org/schemas/1.0.0/mcp.schema.json",
  "mcpServers": {
    "freelaw-studio": {
      "type": "streamable-http",
      "url": "https://app.freelaw.ai/api/agent/mcp",
      "extensions": {
        "com.openai": {
          "auth": {
            "type": "oauth",
            "client": {
              "mode": "dcr"
            },
            "baseScopes": ["office:read", "office:write"]
          }
        }
      }
    }
  }
}
